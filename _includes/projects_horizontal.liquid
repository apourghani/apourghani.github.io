<div class="card-item">
  <div class="card hoverable">
    <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
      <div{% if project.img %} class="project-card-layout"{% endif %}>
        {% if project.img %}
          <div class="p-3">
            {% assign image_alt = project.img_alt | default: 'Project thumbnail' %}
            <img class="img-fluid" src="{{ project.img | relative_url }}" alt="{{ image_alt | escape }}" loading="lazy">
          </div>
        {% endif %}
        <div>
          <div class="card-body">
            <h2 class="card-title">{{ project.title }}</h2>
            {% if project.venue and project.year %}
              <p class="text-muted mb-2">{{ project.venue | escape }} {{ project.year }}</p>
            {% endif %}
            <p class="card-text">{{ project.summary | default: project.description }}</p>
          </div>
        </div>
      </div>
    </a>
    {% if project.github %}
      <div class="row mx-3 mb-3">
        <div class="github-icon">
          <div class="icon" data-toggle="tooltip" title="Code Repository">
            <a href="{{ project.github }}" aria-label="Code repository"><i class="fa-brands fa-github gh-icon"></i></a>
          </div>
          {% if project.github_stars %}
            <span class="stars" data-toggle="tooltip" title="GitHub Stars">
              <i class="fa-solid fa-star"></i>
              <span id="{{ project.github_stars }}-stars"></span>
            </span>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</div>
