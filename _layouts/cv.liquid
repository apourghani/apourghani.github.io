---
layout: default
---
{% assign cv = site.data.cv %}
<article class="research-cv" aria-labelledby="cv-name">
  <header class="research-cv__header">
    <div class="research-cv__intro">
      <div>
        <h1 id="cv-name">{{ cv.name | escape }}</h1>
        <p class="research-cv__position">{{ cv.position | escape }}</p>
      </div>
      {% if page.cv_pdf %}
        <a
          class="research-cv__download"
          href="{{ page.cv_pdf | prepend: '/assets/pdf/' | relative_url }}"
          download="aliasghar-pourghani-cv.pdf"
        >Download CV (PDF)</a>
      {% endif %}
    </div>
    <p class="research-cv__focus">{{ cv.focus | escape }}</p>
    <ul class="research-cv__contacts">
      {% if site.email %}
        <li><a href="mailto:{{ site.email | escape }}">{{ site.email | escape }}</a></li>
      {% endif %}
      {% if site.scholar_userid %}
        <li><a href="https://scholar.google.com/citations?user={{ site.scholar_userid | escape }}">Google Scholar</a></li>
      {% endif %}
      {% if site.linkedin_username %}
        <li><a href="https://www.linkedin.com/in/{{ site.linkedin_username | escape }}/">LinkedIn</a></li>
      {% endif %}
    </ul>
  </header>

  <section class="research-cv__section" aria-labelledby="cv-publications">
    <h2 id="cv-publications">Selected publications</h2>
    <ol class="research-cv__entries">
      {% for paper in cv.publications %}
        <li>
          <h3><a href="https://arxiv.org/abs/{{ paper.arxiv }}">{{ paper.title | escape }}</a></h3>
          <p class="research-cv__meta">
            {% for author in paper.authors %}
              {%- if author == cv.publication_name -%}
                <strong>{{ author | escape }}</strong>
              {%- else -%}
                {{ author | escape }}
              {%- endif -%}
              {%- if paper.joint_first_count and forloop.index <= paper.joint_first_count -%}
                <sup aria-label="joint first author">*</sup>
              {%- endif -%}
              {%- unless forloop.last %}, {% endunless -%}
            {% endfor %}
          </p>
          <p class="research-cv__citation">
            {% if paper.venue %}<strong>{{ paper.venue | escape }}</strong> · {% endif %}
            arXiv:{{ paper.arxiv }}
            {% if paper.joint_first_count %} · <span>*Joint first authors</span>{% endif %}
          </p>
        </li>
      {% endfor %}
    </ol>
  </section>

  <section class="research-cv__section" aria-labelledby="cv-research">
    <h2 id="cv-research">Research experience</h2>
    <ul class="research-cv__entries">
      {% for entry in cv.research %}
        <li>
          <div class="research-cv__entry-heading">
            <h3>{{ entry.title | escape }}, {{ entry.institution | escape }}</h3>
            <p class="research-cv__date">{{ entry.dates | escape }}</p>
          </div>
          {% if entry.description %}<p>{{ entry.description | escape }}</p>{% endif %}
          {% if entry.contributions %}
            <ul class="research-cv__contributions">
              {% for contribution in entry.contributions %}
                <li><strong>{{ contribution.topic | escape }}.</strong> {{ contribution.description | escape }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </section>

  <section class="research-cv__section" aria-labelledby="cv-education">
    <h2 id="cv-education">Education</h2>
    <ul class="research-cv__entries">
      {% for entry in cv.education %}
        <li>
          <div class="research-cv__entry-heading">
            <h3>{{ entry.institution | escape }}</h3>
            <p class="research-cv__date">{{ entry.dates | escape }}</p>
          </div>
          <p>{{ entry.degree | escape }}</p>
          <p class="research-cv__meta">{{ entry.location | escape }} · {{ entry.detail | escape }}</p>
        </li>
      {% endfor %}
    </ul>
    <p class="research-cv__coursework"><strong>Selected coursework</strong> {{ cv.coursework | join: ', ' | escape }}</p>
  </section>

  <section class="research-cv__section" aria-labelledby="cv-skills">
    <h2 id="cv-skills">Technical skills</h2>
    <dl class="research-cv__skills">
      {% for skill in cv.skills %}
        <dt>{{ skill.area | escape }}</dt>
        <dd>{{ skill.tools | escape }}</dd>
      {% endfor %}
    </dl>
  </section>

  <section class="research-cv__section" aria-labelledby="cv-honors">
    <h2 id="cv-honors">Honors</h2>
    <ul class="research-cv__entries">
      {% for honor in cv.honors %}
        <li class="research-cv__entry-heading">
          <p>{{ honor.title | escape }}</p>
          <p class="research-cv__date">{{ honor.dates | escape }}</p>
        </li>
      {% endfor %}
    </ul>
  </section>
</article>
